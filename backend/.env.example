# Coopsaas Invest backend
PORT=4100

# Tickr Rails, as Coopsaas. Keep these on the server: never send them to the browser.
TICKR_BASE_URL=http://localhost:3001
TICKR_API_KEY=tkf_replace_me
# From the Tickr Rails dashboard, Settings, Webhook secret. Used to check webhooks really came from Tickr Rails.
TICKR_WEBHOOK_SECRET=whsec_replace_me

# true against a Tickr Rails sandbox: shows "Fill in test details" when opening an account
SANDBOX=true

# Signs member sessions. Any long random string.
SESSION_SECRET=replace_with_a_long_random_string

# Each new member's demo coop savings, in naira
STARTING_SAVINGS=1000000

# Optional cap per deposit or withdrawal, in naira. Leave unset for no cap.
# MAX_TRANSFER=50000
